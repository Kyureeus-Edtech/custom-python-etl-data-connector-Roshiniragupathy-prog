# Copy this file to .env and fill your credentials. DO NOT commit .env
# CIRCL Passive DNS credentials (if available)
CIRCL_USERNAME=
CIRCL_PASSWORD=

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=kyureeus_assignment
MONGODB_COLLECTION=circl_passivedns_raw

# Use MOCK_MODE=true to test locally without CIRCL credentials
MOCK_MODE=true
