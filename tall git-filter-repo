[32m+[m[32mimport pandas as pd[m
[32m+[m[32mimport os[m
[32m+[m[32mfrom pymongo import MongoClient[m
[32m+[m[32mfrom dotenv import load_dotenv[m
[32m+[m
[32m+[m[32m# Load .env if exists[m
[32m+[m[32mload_dotenv()[m
[32m+[m
[32m+[m[32m# ------------------ MongoDB Connection ------------------[m
[32m+[m[32mMONGO_URI = os.getenv("MONGO_URI") or "your_fallback_uri_here"[m
[32m+[m[32mDB_NAME = os.getenv("DB_NAME") or "test_db"[m
[32m+[m[32mCOLLECTION_NAME = os.getenv("COLLECTION_NAME") or "test_collection"[m
[32m+[m
[32m+[m[32mclient = MongoClient(MONGO_URI)[m
[32m+[m[32mdb = client[DB_NAME][m
[32m+[m[32mcollection = db[COLLECTION_NAME][m
[32m+[m
[32m+[m[32m# ------------------ Extract ------------------[m
[32m+[m[32mdef extract():[m
[32m+[m[32m    file_path = os.path.join("raw_data", "verified_online.csv")[m
[32m+[m[32m    print(f"Loading data from {file_path}...")[m
[32m+[m[32m    df = pd.read_csv(file_path)[m
[32m+[m[32m    print(f"Loaded {len(df)} records.")[m
[32m+[m[32m    return df[m
[32m+[m
[32m+[m[32m# ------------------ Transform ------------------[m
[32m+[m[32mdef transform(df):[m
[32m+[m[32m    print("Transforming data...")[m
[32m+[m[32m    # Example transformation: drop empty rows[m
[32m+[m[32m    df = df.dropna()[m
[32m+[m[32m    # Convert dataframe to dictionary[m
[32m+[m[32m    records = df.to_dict(orient='records')[m
[32m+[m[32m    print(f"Transformed {len(records)} records.")[m
[32m+[m[32m    return records[m
[32m+[m
[32m+[m[32m# ------------------ Load ------------------[m
[32m+[m[32mdef load(records):[m
[32m+[m[32m    if records:[m
[32m+[m[32m        result = collection.insert_many(records)[m
[32m+[m[32m        print(f"Inserted {len(result.inserted_ids)} records into MongoDB.")[m
[32m+[m[32m    else:[m
[32m+[m[32m        print("No records to insert.")[m
[32m+[m
[32m+[m[32m# ------------------ Main ETL ------------------[m
[32m+[m[32mif __name__ == "__main__":[m
[32m+[m[32m    df = extract()[m
[32m+[m[32m    records = transform(df)[m
[32m+[m[32m    load(records)[m

